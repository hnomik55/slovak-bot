name: slovak bot

# Бот живёт в GitHub Actions: раз в N минут просыпается, забирает накопленные
# сообщения Telegram и отвечает, затем выключается и сохраняет состояние.
#
# Почему это работает бесплатно: в ПУБЛИЧНОМ репозитории минуты Actions
# не тарифицируются. В приватном — даётся 2 000 минут в месяц, а боту
# на 24/7 нужно 43 200, поэтому приватный репозиторий не подходит.
#
# Telegram хранит непрочитанные апдейты 24 часа, поэтому ответ приходит
# с задержкой в пределах расписания (обычно 0–5 минут).

on:
  schedule:
    - cron: "*/3 * * * *"
  workflow_dispatch:
  push:
    branches: [main]
    paths-ignore:
      - "state/**"
      - "ci-*.txt"
      - "telegram-check.txt"

concurrency:
  group: slovak-bot
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  bot:
    runs-on: ubuntu-latest
    timeout-minutes: 9
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Проверка связи с Telegram (без токена)
        run: |
          {
            echo "Корень API:"
            curl -s -o /dev/null -w "  http=%{http_code} time=%{time_total}s\n" -m 20 https://api.telegram.org/
            echo "Bot API (фиктивный токен, ждём быстрый 401 — значит путь /bot... доступен):"
            curl -s -w "\n  http=%{http_code} time=%{time_total}s\n" -m 20 \
              https://api.telegram.org/bot123456789:FAKE_TOKEN_FOR_CHECK/getMe || echo "  таймаут — путь /bot... недоступен"
          } | tee telegram-check.txt

      - name: Show content stats
        run: python -c "import json;d=json.load(open('data/content.json'));m=d['meta'];print('уроков',m['lessons'],'заданий',m['tasks'],'слов',m['vocab'])"

      - name: Run bot (3.5 minutes)
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          ADMIN_IDS: ${{ secrets.ADMIN_IDS }}
          AI_PROVIDER: ${{ vars.AI_PROVIDER }}
          AI_BASE_URL: ${{ vars.AI_BASE_URL }}
          AI_API_KEY: ${{ secrets.AI_API_KEY }}
          AI_MODEL: ${{ vars.AI_MODEL }}
          MODE: polling
          RUN_SECONDS: 200
          DB_PATH: state/slovak.db
          TTS_ENABLED: "1"
          STT_ENABLED: "0"
          LOG_LEVEL: INFO
        run: |
          if [ -z "$BOT_TOKEN" ]; then
            echo "BOT_TOKEN не задан в Secrets — пропускаю запуск."
            echo "Добавь: Settings -> Secrets and variables -> Actions -> BOT_TOKEN"
            exit 0
          fi
          python bot.py 2>&1 | tee bot-run.log || true

      - name: Публикуем лог запуска бота
        if: always()
        run: |
          git config user.name "ci" && git config user.email "ci@local"
          git checkout -B ci-bot-logs
          git add -A telegram-check.txt bot-run.log || true
          git commit -m "ci: лог запуска бота" || true
          git push -f origin ci-bot-logs || true
          git checkout -f main || true

      - name: Save progress (state/slovak.db)
        run: |
          python - <<'PY'
          import os, sqlite3
          if os.path.exists("state/slovak.db"):
              con = sqlite3.connect("state/slovak.db")
              con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
              con.close()
              print("БД сохранена")
          PY
          git config user.name "slovak-bot"
          git config user.email "bot@users.noreply.github.com"
          git add -A state || true
          git commit -m "state: прогресс ученика" || echo "изменений нет"
          git pull --rebase origin main || true
          git push || echo "не удалось запушить (возможен конфликт)"
