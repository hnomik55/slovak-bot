# ============================================================
#  Скопируй этот файл в .env и заполни значения.
# ============================================================

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Твой Telegram id (узнать: напиши @userinfobot) — для админ-команд
ADMIN_IDS=

# --- Пути ---
# Корень с контентом (уроки, словари, письма)
SOURCE_DIR=D:\Slovakia
# Куда бот складывает content.json и базу
DATA_DIR=data
DB_PATH=data/slovak.db

# --- ИИ (необязательно, но без него не будет проверки текста, диалогов и чтения) ---
# openai — любой OpenAI-совместимый API (OpenAI, DeepSeek, Qwen, Mistral, Ollama, LM Studio)
# anthropic — нативный Anthropic API
# off — работает только локальная часть (уроки, слова, SRS, тест, статистика)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Модель для быстрых задач (диалог, разбор ошибки). Пусто = та же, что AI_MODEL
AI_MODEL_FAST=
AI_TIMEOUT=90
AI_TEMPERATURE=0.3

# --- Голос ---
TTS_ENABLED=1
# Словацкие голоса edge-tts: sk-SK-MiroslavNeural, sk-SK-VenuNeural, sk-SK-LukasNeural
TTS_VOICE=sk-SK-LukasNeural
TTS_FALLBACK_VOICES=sk-SK-ViktoriaNeural,sk-SK-LukasNeural
STT_ENABLED=1
# faster-whisper: tiny / base / small / medium  (small — точнее, тянет процессор)
STT_MODEL=small

# --- Gating of lessons ---
# 0 = all lessons are available right away (default)
# 1 = a lesson opens only after 80% on the previous one
STRICT_GATING=0

# --- Прочее ---
DAILY_MINUTES=30
REMINDER_TIME=21:00
REMINDER_TZ=Europe/Bratislava
MAX_DAILY_TASKS=40
LOG_LEVEL=INFO

# --- Режим запуска ---
# polling — бот сам спрашивает Telegram. Нужен постоянный процесс: твой ПК или VPS.
# webhook — Telegram сам шлёт апдейты на твой URL. Для бесплатных веб-хостингов.
MODE=polling
# Адрес веб-приложения без пути, например https://твой-логин.pythonanywhere.com
WEBHOOK_BASE_URL=
# Секрет в URL. Сгенерировать: python tools/set_webhook.py set https://...
WEBHOOK_SECRET=
WEBHOOK_PORT=8000
